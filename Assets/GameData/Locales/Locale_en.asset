  - Key: encounter.worm_and_cultist.name
    Value: "Jaw Worm and Cultist"
    SourceSnapshot: "\u989A\u866B\u4E0E\u90AA\u6559\u5F92"
  - Key: event.abandoned_camp.title
    Value: "Abandoned Camp"
    SourceSnapshot: "\u5E9F\u5F03\u8425\u5730"
  - Key: event.abandoned_camp.desc
    Value: "Supplies still lie beside the dead fire. Whoever camped here left in a hurry."
    SourceSnapshot: "\u7184\u706D\u7684\u706B\u5806\u65C1\u8FD8\u7559\u7740\u4E00\u4E9B\u8865\u7ED9\uFF0C\u770B\u6765\u4E3B\u4EBA\u8D70\u5F97\u5F88\u6025\u3002"
  - Key: event.abandoned_camp.option.0.text
    Value: "Scavenge the supplies"
    SourceSnapshot: "\u641C\u522E\u8865\u7ED9"
  - Key: event.gambling_ghost.title
    Value: "Gambling Ghost"
    SourceSnapshot: "\u8D4C\u9B3C\u5E7D\u9B42"
  - Key: event.gambling_ghost.desc
    Value: "A translucent shape rolls dice in midair.\n\"Care for a wager? Even odds \u2014 but if you win, heh heh.\""
    SourceSnapshot: "\u4E00\u56E2\u534A\u900F\u660E\u7684\u5F71\u5B50\u5728\u7A7A\u4E2D\u63B7\u7740\u9AB0\u5B50\u3002\n\u300C\u62BC\u4E00\u628A\uFF1F\u8F93\u8D62\u5404\u534A\uFF0C\u4F46\u8D62\u7684\u8BDD\u2014\u2014\u563F\u563F\u3002\u300D"
  - Key: event.gambling_ghost.option.0.text
    Value: "Bet 50 Gold"
    SourceSnapshot: "\u62BC\u4E0A 50 \u91D1\u5E01"
  - Key: event.gambling_ghost.option.0.hint
    Value: "Not enough Gold"
    SourceSnapshot: "\u91D1\u5E01\u4E0D\u8DB3"
  - Key: event.gambling_ghost.option.1.text
    Value: "Refuse"
    SourceSnapshot: "\u4E0D\u8D4C"
  - Key: event.gambling_ghost.option.1.result
    Value: "The shape hisses in disappointment and fades away."
    SourceSnapshot: "\u5F71\u5B50\u53D1\u51FA\u5931\u671B\u7684\u5618\u58F0\uFF0C\u6D88\u6563\u4E86\u3002"
  - Key: event.hidden_spring.title
    Value: "Hidden Spring"
    SourceSnapshot: "\u9690\u79D8\u6CC9\u773C"
  - Key: event.hidden_spring.desc
    Value: "Warm water seeps from a crack in the rock face, its surface faintly glowing."
    SourceSnapshot: "\u5CA9\u58C1\u7684\u88C2\u7F1D\u91CC\u6E17\u51FA\u6E29\u70ED\u7684\u6CC9\u6C34\uFF0C\u6C34\u9762\u6CDB\u7740\u5FAE\u5149\u3002"
  - Key: event.hidden_spring.option.0.text
    Value: "Drink deeply"
    SourceSnapshot: "\u75DB\u996E"
  - Key: event.hidden_spring.option.0.result
    Value: "The water tastes of rust, but it works."
    SourceSnapshot: "\u6CC9\u6C34\u5E26\u7740\u94C1\u9508\u5473\uFF0C\u4F46\u786E\u5B9E\u6709\u6548\u3002"
  - Key: event.hidden_spring.option.1.text
    Value: "Fill your waterskin and leave"
    SourceSnapshot: "\u88C5\u6EE1\u6C34\u56CA\u540E\u79BB\u5F00"
  - Key: event.hidden_spring.option.1.result
    Value: "It may come in handy later."
    SourceSnapshot: "\u4E5F\u8BB8\u4EE5\u540E\u7528\u5F97\u4E0A\u3002"
  - Key: event.shrine_of_blood.title
    Value: "Shrine of Blood"
    SourceSnapshot: "\u8840\u4E4B\u795E\u9F9B"
  - Key: event.shrine_of_blood.desc
    Value: "A line is carved into the stone slab: \"Pain, traded for power.\"\nDark red stains still linger in the groove."
    SourceSnapshot: "\u77F3\u53F0\u4E0A\u523B\u7740\u4E00\u884C\u5B57\uFF1A\u300C\u4EE5\u75DB\u695A\u6362\u53D6\u529B\u91CF\u3002\u300D\n\u51F9\u69FD\u91CC\u8FD8\u6B8B\u7559\u7740\u6697\u7EA2\u8272\u7684\u75D5\u8FF9\u3002"
  - Key: event.shrine_of_blood.option.0.text
    Value: "Cut your palm"
    SourceSnapshot: "\u5272\u7834\u624B\u638C"
  - Key: event.shrine_of_blood.option.0.result
    Value: "After the sting, something inside you catches fire."
    SourceSnapshot: "\u523A\u75DB\u4E4B\u540E\uFF0C\u4F60\u611F\u5230\u67D0\u79CD\u4E1C\u897F\u88AB\u70B9\u71C3\u4E86\u3002"
  - Key: event.shrine_of_blood.option.1.text
    Value: "Leave"
    SourceSnapshot: "\u79BB\u5F00"
  - Key: event.shrine_of_blood.option.1.result
    Value: "You decide not to touch it."
    SourceSnapshot: "\u4F60\u51B3\u5B9A\u4E0D\u53BB\u78B0\u5B83\u3002"
  - Key: event.sleeping_guardian.title
    Value: "Sleeping Guardian"
    SourceSnapshot: "\u6C89\u7761\u7684\u5B88\u536B"
  - Key: event.sleeping_guardian.desc
    Value: "A huge figure leans against the wall, motionless.\nGold is scattered at its feet, along with a bundle."
    SourceSnapshot: "\u4E00\u4E2A\u5DE8\u5927\u7684\u8EAB\u5F71\u9760\u5728\u5899\u8FB9\u4E00\u52A8\u4E0D\u52A8\u3002\n\u5B83\u811A\u8FB9\u6563\u843D\u7740\u4E0D\u5C11\u91D1\u5E01\uFF0C\u8FD8\u6709\u4E00\u4E2A\u5305\u88F9\u3002"
  - Key: event.sleeping_guardian.option.0.text
    Value: "Quietly take the Gold"
    SourceSnapshot: "\u6084\u6084\u62FF\u8D70\u91D1\u5E01"
  - Key: event.sleeping_guardian.option.0.result
    Value: "You hold your breath. The haul is generous."
    SourceSnapshot: "\u4F60\u5C4F\u4F4F\u547C\u5438\uFF0C\u6536\u83B7\u9887\u4E30\u3002"
  - Key: event.sleeping_guardian.option.1.text
    Value: "Open the bundle"
    SourceSnapshot: "\u6253\u5F00\u90A3\u4E2A\u5305\u88F9"
  - Key: event.sleeping_guardian.option.1.result
    Value: "Something good was inside \u2014 but you made a noise."
    SourceSnapshot: "\u5305\u88F9\u91CC\u662F\u4E2A\u597D\u4E1C\u897F\u2014\u2014\u4F46\u4F60\u5F04\u51FA\u4E86\u58F0\u54CD\u3002"
  - Key: event.sleeping_guardian.option.2.text
    Value: "Sneak past it"
    SourceSnapshot: "\u7ED5\u5F00\u5B83"
  - Key: event.wandering_smith.title
    Value: "Wandering Smith"
    SourceSnapshot: "\u6E38\u65B9\u94C1\u5320"
  - Key: event.wandering_smith.desc
    Value: "An old man with an enormous toolbox blocks your path.\n\"Want your gear to bite a little harder? Not for free, mind you.\""
    SourceSnapshot: "\u4E00\u4E2A\u80CC\u7740\u5DE8\u5927\u5DE5\u5177\u7BB1\u7684\u8001\u4EBA\u62E6\u4F4F\u4E86\u4F60\u3002\n\u300C\u60F3\u8BA9\u4F60\u7684\u5BB6\u4F19\u4EC0\u66F4\u8D81\u624B\u4E9B\u5417\uFF1F\u5F53\u7136\uFF0C\u4E0D\u767D\u5E72\u3002\u300D"
  - Key: event.wandering_smith.option.0.text
    Value: "Sharpen one (50 Gold)"
    SourceSnapshot: "\u6253\u78E8\u4E00\u4EF6\uFF0850 \u91D1\u5E01\uFF09"
  - Key: event.wandering_smith.option.0.hint
    Value: "Not enough Gold"
    SourceSnapshot: "\u91D1\u5E01\u4E0D\u8DB3"
  - Key: event.wandering_smith.option.0.result
    Value: "The old man hammers away for a while."
    SourceSnapshot: "\u8001\u4EBA\u53EE\u53EE\u5F53\u5F53\u6572\u4E86\u4E00\u9635\u3002"
  - Key: event.wandering_smith.option.1.text
    Value: "Throw out the dead weight (75 Gold)"
    SourceSnapshot: "\u4E22\u6389\u7D2F\u8D58\uFF0875 \u91D1\u5E01\uFF09"
  - Key: event.wandering_smith.option.1.hint
    Value: "Not enough Gold"
    SourceSnapshot: "\u91D1\u5E01\u4E0D\u8DB3"
  - Key: event.wandering_smith.option.1.result
    Value: "\"Should've dumped that thing ages ago.\""
    SourceSnapshot: "\u300C\u8FD9\u73A9\u610F\u513F\u65E9\u8BE5\u6254\u4E86\u3002\u300D"
  - Key: event.wandering_smith.option.2.text
    Value: "Decline"
    SourceSnapshot: "\u8C22\u7EDD"
  - Key: event.whispering_idol.title
    Value: "Whispering Idol"
    SourceSnapshot: "\u4F4E\u8BED\u795E\u50CF"
  - Key: event.whispering_idol.desc
    Value: "A faceless stone figure stands at the fork in the road.\nAs you lean closer, a voice that is not your own speaks in your head: \"Power. For just a little price.\""
    SourceSnapshot: "\u4E00\u5C0A\u6CA1\u6709\u9762\u5B54\u7684\u77F3\u50CF\u7ACB\u5728\u5C94\u8DEF\u53E3\u3002\n\u4F60\u51D1\u8FD1\u65F6\uFF0C\u8111\u5B50\u91CC\u54CD\u8D77\u4E00\u4E2A\u4E0D\u5C5E\u4E8E\u81EA\u5DF1\u7684\u58F0\u97F3\uFF1A\u300C\u529B\u91CF\u3002\u53EA\u8981\u4E00\u70B9\u70B9\u4EE3\u4EF7\u3002\u300D"
  - Key: event.whispering_idol.option.0.text
    Value: "Accept the power"
    SourceSnapshot: "\u63A5\u53D7\u529B\u91CF"
  - Key: event.whispering_idol.option.0.result
    Value: "You got what you wanted. Something else moved into your deck."
    SourceSnapshot: "\u4F60\u62FF\u5230\u4E86\u60F3\u8981\u7684\u4E1C\u897F\u3002\u67D0\u79CD\u4E1C\u897F\u4E5F\u4F4F\u8FDB\u4E86\u4F60\u7684\u724C\u7EC4\u3002"
  - Key: event.whispering_idol.option.1.text
    Value: "Loot the idol (gain Gold)"
    SourceSnapshot: "\u63A0\u593A\u795E\u50CF\uFF08\u83B7\u5F97\u91D1\u5E01\uFF09"
  - Key: event.whispering_idol.option.1.result
    Value: "As the stone shatters, the voice laughs."
    SourceSnapshot: "\u77F3\u50CF\u788E\u88C2\u65F6\uFF0C\u90A3\u4E2A\u58F0\u97F3\u7B11\u4E86\u3002"
  - Key: event.whispering_idol.option.2.text
    Value: "Cover your ears and walk away"
    SourceSnapshot: "\u6342\u4F4F\u8033\u6735\u8D70\u5F00"
  - Key: event.whispering_idol.option.2.result
    Value: "The voice grows distant."
    SourceSnapshot: "\u58F0\u97F3\u6E10\u6E10\u8FDC\u4E86\u3002"
