    SourceSnapshot: "\u6BCF\u573A\u6218\u6597\u7684\u7B2C\u4E00\u56DE\u5408\u989D\u5916\u62BD 2 \u5F20\u724C\u3002"
  - Key: relic.black_star.name
    Value: "Black Star"
    SourceSnapshot: "\u9ED1\u661F"
  - Key: relic.black_star.desc
    Value: "Gain 1 extra Energy each turn."
    SourceSnapshot: "\u6BCF\u56DE\u5408\u989D\u5916\u83B7\u5F97 1 \u70B9\u80FD\u91CF\u3002"
  - Key: relic.blood_vial.name
    Value: "Blood Vial"
    SourceSnapshot: "\u8840\u74F6"
  - Key: relic.blood_vial.desc
    Value: "Heal 2 HP at the start of each battle."
    SourceSnapshot: "\u6BCF\u573A\u6218\u6597\u5F00\u59CB\u65F6\u56DE\u590D 2 \u70B9\u751F\u547D\u3002"
  - Key: relic.bronze_scales.name
    Value: "Bronze Scales"
    SourceSnapshot: "\u9752\u94DC\u9CDE\u7247"
  - Key: relic.bronze_scales.desc
    Value: "Gain 3 Thorns at the start of each battle."
    SourceSnapshot: "\u6BCF\u573A\u6218\u6597\u5F00\u59CB\u65F6\u83B7\u5F97 3 \u5C42\u8346\u68D8\u3002"
  - Key: relic.burning_blood.name
    Value: "Burning Blood"
    SourceSnapshot: "\u71C3\u70E7\u4E4B\u8840"
  - Key: relic.burning_blood.desc
    Value: "Heal 6 HP after winning a battle."
    SourceSnapshot: "\u6218\u6597\u80DC\u5229\u540E\u56DE\u590D 6 \u70B9\u751F\u547D\u3002"
  - Key: relic.echo_charm.name
    Value: "Echo Charm"
    SourceSnapshot: "\u56DE\u54CD\u62A4\u7B26"
  - Key: relic.echo_charm.desc
    Value: "The first Attack you play each turn resolves one extra time."
    SourceSnapshot: "\u6BCF\u56DE\u5408\u6253\u51FA\u7684\u7B2C\u4E00\u5F20\u653B\u51FB\u724C\u4F1A\u989D\u5916\u7ED3\u7B97\u4E00\u6B21\u3002"
  - Key: relic.lantern.name
    Value: "Lantern"
    SourceSnapshot: "\u63D0\u706F"
  - Key: relic.lantern.desc
    Value: "Gain 1 extra Energy on the first turn of each battle."
    SourceSnapshot: "\u6BCF\u573A\u6218\u6597\u7684\u7B2C\u4E00\u56DE\u5408\u989D\u5916\u83B7\u5F97 1 \u70B9\u80FD\u91CF\u3002"
  - Key: relic.lizard_tail.name
    Value: "Lizard Tail"
    SourceSnapshot: "\u8725\u8734\u5C3E\u5DF4"
  - Key: relic.lizard_tail.desc
    Value: "Once per battle, the first time you would take lethal damage, survive at 1 HP and heal 10 HP."
    SourceSnapshot: "\u6BCF\u573A\u6218\u6597\u4E2D\uFF0C\u7B2C\u4E00\u6B21\u53D7\u5230\u81F4\u6B7B\u4F24\u5BB3\u65F6\u4FDD\u7559 1 \u70B9\u751F\u547D\uFF0C\u5E76\u56DE\u590D 10 \u70B9\u751F\u547D\u3002"
  - Key: relic.meditation_beads.name
    Value: "Meditation Beads"
    SourceSnapshot: "\u51A5\u60F3\u5FF5\u73E0"
  - Key: relic.meditation_beads.desc
    Value: "Every 3 Skills you play, heal 2 HP."
    SourceSnapshot: "\u6BCF\u6253\u51FA 3 \u5F20\u6280\u80FD\u724C\uFF0C\u56DE\u590D 2 \u70B9\u751F\u547D\u3002"
  - Key: relic.pen_nib.name
    Value: "Pen Nib"
    SourceSnapshot: "\u7B14\u5C16"
  - Key: relic.pen_nib.desc
    Value: "The first Attack you play each turn costs 1 less."
    SourceSnapshot: "\u6BCF\u56DE\u5408\u6253\u51FA\u7684\u7B2C\u4E00\u5F20\u653B\u51FB\u724C\u8D39\u7528 -1\u3002"
  - Key: relic.philosophers_stone.name
    Value: "Philosopher's Stone"
    SourceSnapshot: "\u8D24\u8005\u4E4B\u77F3"
  - Key: relic.philosophers_stone.desc
    Value: "Draw 1 extra card each turn."
    SourceSnapshot: "\u6BCF\u56DE\u5408\u989D\u5916\u62BD 1 \u5F20\u724C\u3002"
  - Key: relic.recycler.name
    Value: "Recycler"
    SourceSnapshot: "\u56DE\u6536\u5668"
  - Key: relic.recycler.desc
    Value: "Skills you play are shuffled back into the draw pile instead of going to the discard pile."
    SourceSnapshot: "\u6253\u51FA\u7684\u6280\u80FD\u724C\u6D17\u56DE\u62BD\u724C\u5806\uFF0C\u800C\u4E0D\u662F\u8FDB\u5165\u5F03\u724C\u5806\u3002"
  - Key: relic.toolbox.name
    Value: "Toolbox"
    SourceSnapshot: "\u5DE5\u5177\u7BB1"
  - Key: relic.toolbox.desc
    Value: "Gain 12 extra Gold after winning a battle."
    SourceSnapshot: "\u6218\u6597\u80DC\u5229\u540E\u989D\u5916\u83B7\u5F97 12 \u91D1\u5E01\u3002"
